<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check: loads the game's Seapower-Scripts.dll (read-only) and runs the mod's GameApi.SelfCheck().
       -p:Flavor=voice (default) checks the voice mod's sources, -p:Flavor=ui the interface mod's.
       Only sources free of HarmonyLib / BepInEx / IMGUI are compiled here (Plugin, Patches*, windows are left out). -->
  <PropertyGroup>
    <Flavor Condition="'$(Flavor)' == ''">voice</Flavor>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <GameDir Condition="'$(GameDir)' == ''">/home/user/drive/SteamLibrary/steamapps/common/Sea Power</GameDir>
    <OutputPath Condition="'$(Flavor)' == 'voice'">$(MSBuildThisFileDirectory)../out-selfcheck/</OutputPath>
    <OutputPath Condition="'$(Flavor)' == 'ui'">$(MSBuildThisFileDirectory)../out-selfcheck-ui/</OutputPath>
    <AssemblyName Condition="'$(Flavor)' == 'voice'">selfcheck</AssemblyName>
    <AssemblyName Condition="'$(Flavor)' == 'ui'">selfcheck-ui</AssemblyName>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(Flavor)/</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
    <DefineConstants Condition="'$(Flavor)' == 'voice'">$(DefineConstants);FLAVOR_VOICE</DefineConstants>
    <DefineConstants Condition="'$(Flavor)' == 'ui'">$(DefineConstants);FLAVOR_UI;UI_CHECKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../Common/**/*.cs" Exclude="../Common/Patches.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Flavor)' == 'voice'">
    <Compile Include="../VoiceBotBridge/VoiceCommands.cs;../VoiceBotBridge/UiLink.cs;../VoiceBotBridge/Server.cs;../VoiceBotBridge/State.cs;../VoiceBotBridge/Events.cs;../VoiceBotBridge/Dispatch.cs;../VoiceBotBridge/Mission.cs;../VoiceBotBridge/Dialogs.cs;../VoiceBotBridge/ModInfo.cs;../VoiceBotBridge/ModManifest.cs;../VoiceBotBridge/VoiceOnly/*.cs" />
