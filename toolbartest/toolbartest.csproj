<Project Sdk="Microsoft.NET.Sdk">
  <!-- T-174: light stand for the game-panel toolbar buttons (pure rules, glyphs, preview sheet). No game, no Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>VoiceBotBridge</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0067</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ToolbarTests.cs" />
    <Compile Include="ToolbarSheet.cs" />
    <Compile Include="../SeaPowerTacticalUI/ToolbarMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/ToolbarGlyphs.cs" />
    <Compile Include="../SeaPowerTacticalUI/NtdsIcons.cs" />
  </ItemGroup>
</Project>
