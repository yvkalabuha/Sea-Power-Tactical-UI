<Project Sdk="Microsoft.NET.Sdk">
  <!-- T-137 A: light stand for the pure range-ring math and model (no game, no Unity). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>VoiceBotBridge</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LeakCases.cs" />
    <Compile Include="PainterCases.cs" />
    <Compile Include="OrthoCases.cs" />
    <Compile Include="../SeaPowerTacticalUI/DrawGuard.cs" />
    <Compile Include="../SeaPowerTacticalUI/RangeRingMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/RangeRingKin.cs" />
    <Compile Include="../SeaPowerTacticalUI/RangeRingModel.cs" />
    <Compile Include="../SeaPowerTacticalUI/RangeRingPins.cs" />
    <Compile Include="../SeaPowerTacticalUI/RangeRingReach.cs" />
    <!-- T-309 D: the exact projector (MapProjector uses Affine2 from CoverageMath) -->
    <Compile Include="../SeaPowerTacticalUI/MapProjector.cs;../SeaPowerTacticalUI/MapPx.cs;../SeaPowerTacticalUI/CoverageMath.cs;../SeaPowerTacticalUI/UiText.cs" />
    <!-- stream C adds ../SeaPowerTacticalUI/IRtOverlay.cs (RtOverlays.SelfTest) with a Condition="Exists" line -->
    <Compile Include="../SeaPowerTacticalUI/IRtOverlay.cs" Condition="Exists('../SeaPowerTacticalUI/IRtOverlay.cs')" />
  </ItemGroup>
</Project>
