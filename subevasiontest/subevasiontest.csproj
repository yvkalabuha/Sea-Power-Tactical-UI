<Project Sdk="Microsoft.NET.Sdk">
  <!-- T-101: light stand for the pure submarine evasion code (no game, no Unity): SubEvasionMath and SubEvasionController on a fake game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>VoiceBotBridge</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SubEvasionMathTests.cs" />
    <Compile Include="SubEvasionControllerTests.cs" />
    <Compile Include="SubEvasionFakeGame.cs" />
    <Compile Include="../SeaPowerTacticalUI/SubEvasionMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/SubEvasionController.cs" />
    <Compile Include="../SeaPowerTacticalUI/EvasionMath.cs" />
    <Compile Include="../Common/Json.cs" />
  </ItemGroup>
</Project>
