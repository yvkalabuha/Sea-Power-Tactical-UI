<Project Sdk="Microsoft.NET.Sdk">
  <!-- T-107 A: light stand for the pure map-layer code (no game, no Unity). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>VoiceBotBridge</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../SeaPowerTacticalUI/UiText.cs" />
    <Compile Include="../SeaPowerTacticalUI/CoverageMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/ProcThreads.cs;../SeaPowerTacticalUI/ModThreads.cs;../SeaPowerTacticalUI/ModShutdown.cs" />   <!-- T-212 -->
    <Compile Include="../SeaPowerTacticalUI/MapLayerMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/CoverageTerrainBroker.cs" />   <!-- T-225 -->
  </ItemGroup>
</Project>
