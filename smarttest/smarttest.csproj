<Project Sdk="Microsoft.NET.Sdk">
  <!-- T-102: light stand for the pure smart-attack code (no game, no Unity). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>VoiceBotBridge</RootNamespace>
    <DefineConstants>$(DefineConstants)</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../Common/Json.cs" />
    <Compile Include="ActionStepShim.cs" />
    <Compile Include="../Common/ActionJournal.cs" />
    <Compile Include="../Common/ControlMemory.cs" />
    <Compile Include="../SeaPowerTacticalUI/UiText.cs" />
    <Compile Include="../SeaPowerTacticalUI/SmartAttackMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/SmartAttackSave.cs" />
    <Compile Include="../SeaPowerTacticalUI/SaveSlotStore.cs" />   <!-- T-122 -->
    <Compile Include="../SeaPowerTacticalUI/SmartAttackCommands.cs" />
    <Compile Include="../SeaPowerTacticalUI/SmartAttackController.cs" />
    <!-- SmartAttackPick.cs (pure SmartPickModel) belongs to stream D1; picked up as soon as it exists. -->
    <Compile Include="../SeaPowerTacticalUI/SmartAttackPick.cs" Condition="Exists('../SeaPowerTacticalUI/SmartAttackPick.cs')" />
    <Compile Include="SmartFakeGame.cs" />
    <Compile Include="SmartControllerTests.cs" />
  </ItemGroup>
</Project>
