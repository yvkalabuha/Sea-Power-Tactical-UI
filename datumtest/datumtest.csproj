    <Compile Include="../SeaPowerTacticalUI/UiFrameMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/RadialMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/UiOrderTypes.cs" />
    <Compile Include="../puretest/RecordPainter.cs" />
    <Compile Include="../SeaPowerTacticalUI/UiText.cs" />
    <Compile Include="../Common/Json.cs" />
