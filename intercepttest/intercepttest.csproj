    <Compile Include="../Common/Json.cs" />
    <Compile Include="../SeaPowerTacticalUI/AswMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/AirOpsMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/SarRouteMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/InterceptMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/InterceptThreat.cs" />
    <Compile Include="InterceptZoneTests.cs" />
    <Compile Include="../SeaPowerTacticalUI/InterceptRoute.cs" />
    <Compile Include="../SeaPowerTacticalUI/InterceptController.cs" />
    <Compile Include="../SeaPowerTacticalUI/TerrainHeightCache.cs" />
    <Compile Include="../SeaPowerTacticalUI/UnitSteering.cs" />
    <Compile Include="../SeaPowerTacticalUI/ContactInfoModel.cs" />
    <Compile Include="../SeaPowerTacticalUI/ContactInfoMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/CoverageMath.cs" />
  </ItemGroup>
</Project>
