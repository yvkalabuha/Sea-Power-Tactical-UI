<Project Sdk="Microsoft.NET.Sdk">
  <!-- T-141: light stand for the pure anti-torpedo maths and the Kresta-II pass (no game, no Unity). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>VoiceBotBridge</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AtwSim.cs" />
    <Compile Include="AtwMultiSim.cs" />
    <Compile Include="AtwTurnSim.cs" />
    <Compile Include="AtwFrozenSim.cs" />
    <Compile Include="../SeaPowerTacticalUI/AntiTorpedoMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/AtwTurnMath.cs" />
    <Compile Include="../SeaPowerTacticalUI/EvasionMath.cs" />
  </ItemGroup>
</Project>
